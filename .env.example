MAIN_APP_HTTP_PORT=5001
MAIN_APP_HOST=127.0.0.1
MAIN_APP_TCP_PORT=3001
FRONTEND_URL=http://localhost:5173,http://localhost:3000
# Must be a replica set / Atlas cluster: live-match code uses multi-document transactions
MONGODB_URL=mongodb://localhost:27017/cricket_db?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# Shared secret used to sign (main-app) and verify (gateway) admin JWTs. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# First super admin, created on startup only if no admin user exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
